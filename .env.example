# settings for a local run. copy this file to .env and fill it in. .env is gitignored: never commit it.
# in the home assistant app, the same keys come from the app settings, in lowercase.

# the plex server, for example https://192-168-1-2.0123abcd.plex.direct:32400
PLEX_URL=
# a dedicated token for this service. see docs/plan.md for how to link one.
PLEX_TOKEN=
# the client identifier that was used to link the token (any uuid)
PLEX_CLIENT_ID=
# the machine identifier of the player to follow. the service logs every player that it sees.
PLEX_PLAYER_ID=

# the mqtt broker (the mosquitto app in home assistant) and a login for this service
MQTT_HOST=
MQTT_USER=
MQTT_PASSWORD=
# the friendly name of the zigbee2mqtt group of the lights
ZIGBEE2MQTT_GROUP=

# optional: the timing, in seconds. the values here are the defaults.
# SYNC_FADE=2
# SYNC_SEND_OFFSET=0.3
# SYNC_MIN_GAP=2
# SYNC_RESTORE_DELAY=30
# SYNC_RESTORE_FADE=3

# optional: the color picker. the values here are the defaults.
# COLOR_BLACK_LEVEL=0.06
# COLOR_MIN_SATURATION=0.2
# COLOR_SATURATION_BOOST=1.5
