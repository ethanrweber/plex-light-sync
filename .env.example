# settings for a local run. copy this file to .env and fill it in. .env is gitignored: never commit it.
# in the home assistant app, the same keys come from the app settings, in lowercase.

# the plex server, for example https://192-168-1-2.0123abcd.plex.direct:32400
PLEX_URL=
# a dedicated token for this service. see docs/plan.md for how to link one.
PLEX_TOKEN=
# the client identifier that was used to link the token (any uuid)
PLEX_CLIENT_ID=
# the machine identifier of the player to follow. the service logs every player that it sees.
PLEX_PLAYER_ID=
